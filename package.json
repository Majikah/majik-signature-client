{
  "name": "@majikah/majik-signature-client",
  "type": "module",
  "description": "High-level TypeScript client for Majik Signature content signing and verification, including account integration, contacts, detached batch streaming, stamps, and backups.",
  "version": "1.6.0",
  "license": "Apache-2.0",
  "author": "Zelijah",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majikah/majik-signature-client.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "keywords": [
    "digital-signature",
    "content-signing",
    "content-verification",
    "tamper-evident",
    "tamper-detection",
    "post-quantum",
    "post-quantum-cryptography",
    "hybrid-cryptography",
    "ml-dsa",
    "ml-dsa-87",
    "ed25519",
    "cryptography",
    "signature-verification",
    "data-integrity",
    "content-authentication",
    "majikah",
    "majik-signature"
  ],
  "homepage": "https://github.com/Majikah/majik-signature-client#readme",
  "bugs": {
    "url": "https://github.com/Majikah/majik-signature-client/issues"
  },
  "scripts": {
    "update:dev": "npm i -D @types/node@latest vitest@latest",
    "update": "npm install @majikah/majik-key@latest @majikah/majik-key-client@latest @majikah/majik-signature@latest @majikah/majik-contact@latest @majikah/majik-file@latest",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "package": "npm run build && npm version patch && git push && git push --tags",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@majikah/majik-cjson": "^0.0.3",
    "@majikah/majik-contact": "^0.2.0",
    "@majikah/majik-file": "^0.8.1",
    "@majikah/majik-key": "^1.1.0",
    "@majikah/majik-key-client": "^0.8.0",
    "@majikah/majik-signature": "^1.6.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
